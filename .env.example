# ============================================================
# Medactio Pilotage — variables d'environnement
# Copier ce fichier vers .env et renseigner les valeurs.
# .env n'est jamais versionné : aucun secret ne doit être commité.
# ============================================================

NODE_ENV=development
PORT=3000

# ---- Base de données ----
# Supabase : Settings > Database > Connection string > Session pooler
# Développement local : postgresql://<utilisateur>@127.0.0.1:5432/medactio_pilotage
DATABASE_URL=

# ---- Supabase (authentification et stockage des documents) ----
# Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Mêmes valeurs côté navigateur. La clé anon est publique par conception :
# l'accès direct aux tables est bloqué par RLS (voir supabase/setup.sql).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Adresse email qui reçoit automatiquement le rôle administrateur
OWNER_EMAIL=

# ---- Capture des leads du site public ----
# Secret partagé avec le backend de medactio.fr, qui relaie les demandes de
# démonstration de serveur à serveur. Générer avec : openssl rand -hex 32
# Voir docs/integration-medactio-fr.md
LEAD_INTAKE_SECRET=

# Origines supplémentaires autorisées à poster depuis un navigateur,
# séparées par des virgules (ex. https://preprod.medactio.fr)
LEAD_CAPTURE_ORIGINS=

# ---- Traitements planifiés ----
# Secret partagé avec pg_cron. Générer avec : openssl rand -hex 32
CRON_SECRET=

# ---- Développement hors ligne ----
# Ouvre une session locale en rôle admin sans passer par Supabase.
# Sans effet dès que NODE_ENV vaut "production".
DEV_AUTH_ENABLED=false
DEV_AUTH_OPEN_ID=dev-admin
DEV_AUTH_NAME="Administrateur Medactio"
DEV_AUTH_EMAIL=admin@medactio.local
